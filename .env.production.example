# Production build inputs. Copy to `.env.production` (gitignored) or set these
# in your CI/build environment. See DEPLOYMENT.md.
#
# Vite reads `.env.production` automatically for `vite build` (mode=production).
# Shell values win over this file, which is what CI should use:
#   VITE_API_URL=https://api-nucleus.raghuenggcollege.com npm run build
#
# NOTE: `.env.development` is NOT read by `vite build` — it applies only to
# `vite dev`. Values needed by a production build must be here or in the shell.

# REQUIRED. The API origin, no trailing slash. On a static host the API is a
# different origin, so there is nothing to be relative to and the build fails
# without this. Baked into the bundle; the WebSocket origin for student chat and
# both notification streams is derived from it.
VITE_API_URL=https://api-nucleus.raghuenggcollege.com

# Google OIDC client id for the student and employee sign-in buttons. Must match
# GOOGLE_STUDENT_OIDC_CLIENT_ID / GOOGLE_EMPLOYEE_OIDC_CLIENT_ID in
# nucleus-server. Unset, the "Continue with Google" button is simply hidden.
# Every portal origin must also be listed as an authorized JavaScript origin on
# this client in Google Cloud Console.
VITE_GOOGLE_OIDC_CLIENT_ID=

# Origin serving presigned S3 URLs — student photos, company logos and
# certificates render as <img src> from it. Only widens the generated CSP's
# img-src and connect-src; unset, those images are blocked on any host that
# honours the policy.
#
# ONE origin: nucleus-server uses a single bucket. With S3_FORCE_PATH_STYLE=false
# (required on real AWS) it is addressed virtual-hosted style, so the bucket is
# its own origin. If S3_REGION or S3_BUCKET changes, this changes with it.
VITE_STORAGE_ORIGIN=https://raghu-nucleus.s3.ap-south-1.amazonaws.com

# Sub-path the app is served from, with both slashes. `/` = root hosting, which
# is what all three portal hostnames use.
BASE_PATH=/
