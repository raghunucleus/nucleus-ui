# Base URL of the nucleus-server API during local development.
# nucleus-server/.env sets PORT=3000.
VITE_API_URL=http://localhost:3000

# Google OAuth web client ID. Leave blank to hide the "Sign in with Google"
# button. Use the same client id the server verifies against, and add this
# app's origin (e.g. http://localhost:5000) to the client's authorized
# JavaScript origins in Google Cloud Console.
VITE_GOOGLE_OIDC_CLIENT_ID=19344277040-qthejudc9ut37ve78964e7p9k018p67m.apps.googleusercontent.com
